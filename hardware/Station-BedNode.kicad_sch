  (rectangle (start 25.4 207.01) (end 277.4 276.86) (stroke (width 0.1) (type dash)) (fill (type none)) (uuid "69526cab-6ef8-419e-a3b0-57db252c5f3e"))
  (text "ASSEMBLY NOTES" (at 29.21 214.63 0) (effects (font (size 1.778 1.778) bold) (justify left)) (uuid "77106c37-04bd-4b7c-a14b-9e809ea7be8a"))
  (text "1. All GPIO numbers are read directly from firmware v7.7.3 by the generator script;" (at 29.21 220.98 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "e62b4e0b-627d-4637-845d-8e60fbb6cb4f"))
  (text "   they are never typed in by hand. Re-run tools/kicad-gen/gen_schematics.py after a pin change." (at 29.21 227.33 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "a33f6e38-1cdc-43ee-b405-4250bae0d28d"))
  (text "2. SW1 uses pinMode(INPUT_PULLUP), so it wires straight to GND. No external pull-up resistor." (at 29.21 233.68 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "b28fd9df-c5da-4f31-a0f5-5ea475a3b85f"))
  (text "3. RGB_LED (GPIO48) is the WS2812 already fitted on the ESP32-S3 Super Mini board." (at 29.21 240.03 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "4f7ca19b-8754-45fb-8999-054d7d393dc1"))
  (text "   Nothing is wired externally - the net is shown for reference only." (at 29.21 246.38 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "12c2ef59-7579-43f2-9009-d1e674ddb150"))
  (text "4. TCRT5000 DO pin is unused. The firmware reads the analog AO pin only." (at 29.21 252.73 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "968bbb02-becd-472b-aa81-2ebcbdc815ff"))
  (text "5. Power the sensor and the display from 3V3, never 5V: ESP32-S3 GPIO pins are 3.3V only." (at 29.21 259.08 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "d616ef7b-164f-4332-83bb-74ff629409a6"))
  (text "6. BZ1 is a PASSIVE buzzer driven by tone(). A magnetic buzzer needs an NPN driver stage." (at 29.21 265.43 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "19648aee-851c-447e-bcf5-7817fbf6fd5c"))
  (text "7. Station battery sensing is disabled in firmware (STATION_BAT_ADC_PIN = -1), so it is not drawn." (at 29.21 271.78 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid "19c09198-cca7-4e9c-87a2-4c3df8e6773a"))
  (sheet_instances (path "/" (page "1")))
)
